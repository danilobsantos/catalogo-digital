APP_NAME="CJ Calçados"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contato@teste.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Armazenamento local (public)

SCOUT_DRIVER=null

VITE_APP_NAME="${APP_NAME}"

# ---- Catálogo Digital Premium ----
APP_DOMAIN=cjcalcados.com.br
WHATSAPP_DEFAULT_NUMBER=
WHATSAPP_DEFAULT_MESSAGE="Olá! Tenho interesse no produto {produto} (cód. {codigo})."
CATALOG_COMPANY_DEFAULT="CJ Calçados"
